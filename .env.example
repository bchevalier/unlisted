NODE_ENV=development
# Canonical URL vars used by current server code:
# - APP_URL: client/app base URL
# - NEXTAUTH_URL: auth/API base URL hosting /api/auth/*
APP_URL=http://localhost:3333
NEXTAUTH_URL=http://localhost:3333
NEXTAUTH_SECRET=dev-secret-that-is-at-least-32-characters
DATABASE_URL=postgresql://postgres:password@localhost:5432/knokio?schema=public
ENABLE_REACH=true

# Stripe billing (required for subscription features)
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_ID=price_PLACEHOLDER

# Reach safety tuning (all have sensible defaults)
REACH_ACTOR_RATE_LIMIT_MAX=30
REACH_ACTOR_RATE_LIMIT_WINDOW_MINUTES=60
REACH_PAIR_COOLDOWN_MINUTES=60
REACH_ABUSE_REPORT_RATE_LIMIT_MAX=10
REACH_ABUSE_REPORT_RATE_LIMIT_WINDOW_MINUTES=60

# Social verification rate limits (per actor, sliding window)
# REACH_SOCIAL_CREATE_LIMIT=10            # Max challenge creations per window (default 10)
# REACH_SOCIAL_CREATE_WINDOW_SECONDS=3600 # Window in seconds (default 1 hour)
# REACH_SOCIAL_VERIFY_LIMIT=20            # Max verify attempts per window (default 20)
# REACH_SOCIAL_VERIFY_WINDOW_SECONDS=3600
# REACH_SOCIAL_DELETE_LIMIT=20            # Max deletes per window (default 20)
# REACH_SOCIAL_DELETE_WINDOW_SECONDS=3600

# Reach webhook HMAC signing secret (optional; per-webhook secrets preferred)
REACH_WEBHOOK_SECRET=

# Embeddings provider abstraction (ordered fallback)
# OpenAI-compatible defaults optimize cost/perf for retrieval stage-1.
EMBEDDING_PROVIDER_ORDER=openai,voyage,google
EMBEDDING_TIMEOUT_MS=12000

# OpenAI embeddings provider
OPENAI_API_KEY=OPENAI_API_KEY_PLACEHOLDER
EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
EMBEDDINGS_OPENAI_BASE_URL=https://api.openai.com/v1

# Voyage embeddings provider (optional fallback)
VOYAGE_API_KEY=
EMBEDDINGS_VOYAGE_MODEL=voyage-3-lite
EMBEDDINGS_VOYAGE_BASE_URL=https://api.voyageai.com/v1

# Google embeddings provider (optional fallback)
GOOGLE_API_KEY=
EMBEDDINGS_GOOGLE_MODEL=text-embedding-004
EMBEDDINGS_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
EMBEDDINGS_GOOGLE_API_VERSION=v1beta

# Keeper auth session signing secret (32+ chars)
KEEPER_SESSION_SECRET=replace-with-32-char-min-secret

# Admin panel bootstrap (internal use only)
# Preferred: register normally, set ADMIN_EMAIL to that account, then run:
#   npm run admin:bootstrap
ADMIN_EMAIL=admin@knokio.io
ADMIN_SESSION_SECRET=replace-with-32-char-min-secret-for-admin
# Legacy fallback (deprecated): direct env-only bootstrap hash
ADMIN_PASSWORD_HASH=

# Auth secret for encrypting local 2FA data (32+ chars)
AUTH_ENCRYPTION_SECRET=replace-with-32-char-min-secret

# Agent-only signup secret (header-based auth for machine signup flow, no captcha)
AGENT_SIGNUP_SECRET=replace-with-32-char-min-secret

# Return raw auth tokens in API debug responses (recommended true only in dev)
AUTH_DEBUG_RETURN_TOKENS=true

# Optional: secure inbound email webhook
INBOUND_EMAIL_WEBHOOK_SECRET=

# Inbound email sender rate limit
EMAIL_SENDER_RATE_LIMIT_WINDOW_MINUTES=60
EMAIL_SENDER_RATE_LIMIT_MAX=5

# Public form submission rate limits (per-door)
FORM_IP_RATE_LIMIT_WINDOW_MINUTES=15
FORM_IP_RATE_LIMIT_MAX=10
FORM_SENDER_RATE_LIMIT_WINDOW_MINUTES=60
FORM_SENDER_RATE_LIMIT_MAX=5

# Cloudflare Turnstile bot protection (optional — skipped when unset)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cron endpoints (Direct: POST /api/direct/requests/expire, Reach: POST /api/reach/contracts/expire)
CRON_SECRET=
REQUEST_EXPIRY_DAYS=30

# External provider auth (token verification)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=
LINKEDIN_CLIENT_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ─── Reach Social Verification ────────────────────────────────────────
# Creator ownership verification via profile-bio challenge markers.
# Each platform adapter checks its own env vars at call time and returns
# PLATFORM_NOT_CONFIGURED (412) if the required credentials are missing.
# See docs/Reach-Social-Provider-Setup.md for setup instructions.

# YouTube Data API v3 — required for YouTube adapter
# Get an API key at https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in the API library.
# Quota: 10,000 units/day default (channels.list = 1 unit).
YOUTUBE_API_KEY=

# Meta Graph API — required for Instagram (and Facebook when implemented)
# Create a Meta App at https://developers.facebook.com/apps/
# Add "Instagram Basic Display" or "Instagram API" product.
META_APP_ID=
META_APP_SECRET=
# Instagram V1: static user access token for testing.
# Production will use per-actor OAuth token storage.
INSTAGRAM_USER_ACCESS_TOKEN=

# TikTok API — scaffolded, requires app review + Login Kit
# Create app at https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X (Twitter) API v2 — required for X adapter
# Create a project at https://developer.x.com/en/portal/
# Generate a Bearer Token (app-only auth).
# Rate limit: 300 req/15min for user lookup.
X_API_BEARER_TOKEN=

# Dev-only fallback to test verify flow without live provider adapters.
# MUST be false (or unset) in production — server will refuse to start otherwise.
SOCIAL_VERIFICATION_ALLOW_BIO_OVERRIDE=false

# Auth email delivery (Resend optional; falls back to server log output)
AUTH_EMAIL_FROM=Knokio <no-reply@knokio.io>
RESEND_API_KEY=

# Notification email sender (defaults to AUTH_EMAIL_FROM if unset)
NOTIFICATION_EMAIL_FROM=

# Error tracking (provider-agnostic; optional; defaults to logs-only)
# Providers: none | sentry | bugsink | glitchtip
ERROR_TRACKING_PROVIDER=none
# Generic DSN for chosen provider (preferred). Legacy SENTRY_DSN still supported.
ERROR_TRACKING_DSN=
# Optional SDK package override (default: @sentry/nextjs for sentry-compatible providers)
ERROR_TRACKING_SDK_PACKAGE=@sentry/nextjs

# Backward-compatible Sentry keys (optional)
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Structured logging level (debug|info|warn|error; defaults to info in production)
LOG_LEVEL=

# Optional seed defaults
DEMO_KEEPER_EMAIL=john@knokio.local
DEMO_KEEPER_NAME=John
DEMO_KEEPER_PASSWORD=changeme123456
DEMO_DOOR_PLAN=FREE
DEMO_DOOR_SLUG=john
DEMO_DOOR_ALIAS=john
