NODE_ENV=development
APP_URL=http://localhost:3333
NEXTAUTH_URL=http://localhost:3333
NEXTAUTH_SECRET=dev-secret-that-is-at-least-32-characters
DATABASE_URL=postgresql://postgres:password@localhost:5432/knokio?schema=public
ENABLE_REACH=true

# Stripe billing (required for subscription features)
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_ID=price_PLACEHOLDER

# Reach safety tuning (all have sensible defaults)
REACH_ACTOR_RATE_LIMIT_MAX=30
REACH_ACTOR_RATE_LIMIT_WINDOW_MINUTES=60
REACH_PAIR_COOLDOWN_MINUTES=60
REACH_ABUSE_REPORT_RATE_LIMIT_MAX=10
REACH_ABUSE_REPORT_RATE_LIMIT_WINDOW_MINUTES=60

# Reach webhook HMAC signing secret (optional; per-webhook secrets preferred)
REACH_WEBHOOK_SECRET=

# Embeddings provider abstraction (ordered fallback)
# OpenAI-compatible defaults optimize cost/perf for retrieval stage-1.
EMBEDDING_PROVIDER_ORDER=openai,voyage,google
EMBEDDING_TIMEOUT_MS=12000

# OpenAI embeddings provider
OPENAI_API_KEY=OPENAI_API_KEY_PLACEHOLDER
EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
EMBEDDINGS_OPENAI_BASE_URL=https://api.openai.com/v1

# Voyage embeddings provider (optional fallback)
VOYAGE_API_KEY=
EMBEDDINGS_VOYAGE_MODEL=voyage-3-lite
EMBEDDINGS_VOYAGE_BASE_URL=https://api.voyageai.com/v1

# Google embeddings provider (optional fallback)
GOOGLE_API_KEY=
EMBEDDINGS_GOOGLE_MODEL=text-embedding-004
EMBEDDINGS_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
EMBEDDINGS_GOOGLE_API_VERSION=v1beta

# Keeper auth session signing secret (32+ chars)
KEEPER_SESSION_SECRET=replace-with-32-char-min-secret

# Admin panel credentials (internal use only)
# Generate hash: node -e "require('bcryptjs').hash('yourpassword',12).then(h=>console.log(h))"
ADMIN_EMAIL=admin@knokio.io
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=replace-with-32-char-min-secret-for-admin

# Auth secret for encrypting local 2FA data (32+ chars)
AUTH_ENCRYPTION_SECRET=replace-with-32-char-min-secret

# Agent-only signup secret (header-based auth for machine signup flow, no captcha)
AGENT_SIGNUP_SECRET=replace-with-32-char-min-secret

# Return raw auth tokens in API debug responses (recommended true only in dev)
AUTH_DEBUG_RETURN_TOKENS=true

# Optional: secure inbound email webhook
INBOUND_EMAIL_WEBHOOK_SECRET=

# Inbound email sender rate limit
EMAIL_SENDER_RATE_LIMIT_WINDOW_MINUTES=60
EMAIL_SENDER_RATE_LIMIT_MAX=5

# Public form submission rate limits (per-door)
FORM_IP_RATE_LIMIT_WINDOW_MINUTES=15
FORM_IP_RATE_LIMIT_MAX=10
FORM_SENDER_RATE_LIMIT_WINDOW_MINUTES=60
FORM_SENDER_RATE_LIMIT_MAX=5

# Cloudflare Turnstile bot protection (optional — skipped when unset)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cron endpoints (Direct: POST /api/direct/requests/expire, Reach: POST /api/reach/contracts/expire)
CRON_SECRET=
REQUEST_EXPIRY_DAYS=30

# External provider auth (token verification)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=
LINKEDIN_CLIENT_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Auth email delivery (Resend optional; falls back to server log output)
AUTH_EMAIL_FROM=Knokio <no-reply@knokio.io>
RESEND_API_KEY=

# Notification email sender (defaults to AUTH_EMAIL_FROM if unset)
NOTIFICATION_EMAIL_FROM=

# Optional seed defaults
DEMO_KEEPER_EMAIL=john@knokio.local
DEMO_KEEPER_NAME=John
DEMO_KEEPER_PASSWORD=changeme123456
DEMO_DOOR_PLAN=FREE
DEMO_DOOR_SLUG=john
DEMO_DOOR_ALIAS=john
