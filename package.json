{
  "name": "knokio",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "next": "15.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.5"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.14.0",
    "eslint-config-next": "15.1.2",
    "prettier": "3.3.3",
    "prisma": "^6.14.0",
    "typescript": "5.6.3"
  }
}
