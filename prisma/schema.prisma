generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContactRevealMethod {
  NONE
  EMAIL
  URL
}

enum CategoryFieldType {
  TEXT
  TEXTAREA
  NUMBER
  URL
  EMAIL
}

enum RequestSource {
  FORM
  EMAIL
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  AWAITING_COMPLETION
}

enum RequestEventType {
  CREATED
  ACCEPTED
  DECLINED
  EXPIRED
  AUTO_REPLIED
}

enum RequestEventActor {
  SYSTEM
  KEEPER
}

enum DoorPlan {
  FREE
  PAID
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  APPLE
  LINKEDIN
  PRIVY
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_CHALLENGE
}

enum AuthActionType {
  SIGNUP
  LOGIN
  PASSWORD_RESET_REQUEST
  EMAIL_VERIFICATION
}

enum AbuseReportReason {
  SPAM
  HARASSMENT
  IMPERSONATION
  PHISHING
  OTHER
}

enum AbuseReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  passwordHash     String?
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  door              Door?
  identities        AuthIdentity[]
  authTokens        AuthToken[]
  recoveryCodes     TwoFactorRecoveryCode[]
  reachActor        ReachActor?
}

model AuthIdentity {
  id              String       @id @default(cuid())
  userId          String
  provider        AuthProvider
  providerSubject String
  providerEmail   String?
  walletAddress   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@index([walletAddress])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  consumedAt DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, tokenHash])
  @@index([userId, type, expiresAt])
}

model TwoFactorRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model AuthAttempt {
  id        String         @id @default(cuid())
  action    AuthActionType
  ipHash    String?
  email     String?
  success   Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([action, createdAt])
  @@index([email, action, createdAt])
  @@index([ipHash, action, createdAt])
}

model Door {
  id          String   @id @default(cuid())
  userId      String   @unique
  slug        String   @unique
  displayName String
  headline    String?
  plan        DoorPlan @default(FREE)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings        DoorSettings?
  categories      Category[]
  emailAliases    EmailAlias[]
  requests        Request[]
  blockedSenders  DoorBlockedSender[]
  abuseReports    AbuseReport[]

  @@index([slug, isEnabled])
}

model DoorSettings {
  id               String             @id @default(cuid())
  doorId           String             @unique
  autoReplyEnabled Boolean            @default(false)
  autoReplyMessage String?
  weeklyRequestCap Int?
  revealMethod     ContactRevealMethod @default(NONE)
  revealValue      String?

  // Notification preferences
  notifyNewRequest Boolean            @default(true)
  notifyDigest     Boolean            @default(false)
  lastDigestSentAt DateTime?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  door Door @relation(fields: [doorId], references: [id], onDelete: Cascade)
}

model DoorBlockedSender {
  id        String   @id @default(cuid())
  doorId    String
  email     String
  reason    String?
  createdAt DateTime @default(now())

  door Door @relation(fields: [doorId], references: [id], onDelete: Cascade)

  @@unique([doorId, email])
  @@index([doorId])
}

model AbuseReport {
  id          String             @id @default(cuid())
  requestId   String?
  doorId      String?
  reason      AbuseReportReason
  description String?
  reporterEmail String?
  ipHash      String?
  status      AbuseReportStatus  @default(OPEN)
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime           @default(now())

  request Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  door    Door?    @relation(fields: [doorId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([doorId, createdAt])
  @@index([requestId])
  @@index([ipHash, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  doorId      String
  key         String
  label       String
  description String?
  isEnabled   Boolean  @default(true)
  weeklyCap   Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  door     Door            @relation(fields: [doorId], references: [id], onDelete: Cascade)
  fields   CategoryField[]
  requests Request[]

  @@unique([doorId, key])
  @@index([doorId, isEnabled])
}

model CategoryField {
  id          String           @id @default(cuid())
  categoryId  String
  key         String
  label       String
  type        CategoryFieldType @default(TEXT)
  required    Boolean          @default(false)
  placeholder String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model EmailAlias {
  id        String   @id @default(cuid())
  doorId    String
  alias     String   @unique
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  door Door @relation(fields: [doorId], references: [id], onDelete: Cascade)

  @@index([doorId, isEnabled])
}

model Request {
  id             String       @id @default(cuid())
  doorId         String
  categoryId     String?
  source         RequestSource
  status         RequestStatus @default(PENDING)
  senderName     String?
  senderEmail    String?
  ipHash         String?
  title          String?
  message        String
  structuredData     Json?
  requestToken       String       @unique @default(cuid())
  completionToken    String?      @unique
  completionExpiresAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  door          Door        @relation(fields: [doorId], references: [id], onDelete: Cascade)
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  events        RequestEvent[]
  abuseReports  AbuseReport[]

  @@index([doorId, status, createdAt])
  @@index([doorId, ipHash, createdAt])
  @@index([doorId, senderEmail, createdAt])
  @@index([ipHash, createdAt])
  @@index([status, createdAt])
  @@index([status, completionExpiresAt])
  @@index([categoryId, createdAt])
}

model RequestEvent {
  id        String            @id @default(cuid())
  requestId String
  type      RequestEventType
  actor     RequestEventActor @default(SYSTEM)
  note      String?
  metadata  Json?
  createdAt DateTime          @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

// ---------------------------------------------------------------------------
// Reach domain model
// ---------------------------------------------------------------------------

enum ReachActorType {
  HUMAN
  AI_AGENT
  ORGANIZATION
}

enum ReachContractType {
  HUMAN_HUMAN
  HUMAN_AI
  AI_HUMAN
  AI_AI
}

enum ReachContractStatus {
  PROPOSED
  ACTIVE
  FULFILLED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ReachPolicyAction {
  ACCEPT
  REJECT
  ROUTE
  ESCALATE
}

enum ReachContractEventType {
  CREATED
  ROUTED
  ACCEPTED
  REJECTED
  FULFILLED
  ESCALATED
  EXPIRED
  CANCELLED
  OVERRIDDEN
}

enum ReachContractEventActor {
  SYSTEM
  INITIATOR
  TARGET
  ADMIN
}

/// Role within an organization actor.
enum ReachOrgRole {
  OWNER   // full control: manage members, policies, settings, keys
  ADMIN   // manage policies, view/act on contracts, manage settings
  MEMBER  // propose contracts, view org contracts, act on assigned contracts
}

/// Permission scopes for Reach actor operations.
enum ReachPermission {
  ACTOR_READ        // view own actor profile
  ACTOR_UPDATE      // update displayName, capabilities, endpoint
  ACTOR_DEACTIVATE  // deactivate the actor
  KEY_ROTATE        // regenerate API key
  POLICY_READ       // view policies
  POLICY_WRITE      // create/update/deactivate policies
  CONTRACT_PROPOSE  // propose new contracts
  CONTRACT_READ     // view contracts
  CONTRACT_ACT      // accept/reject/override contracts
  ORG_MEMBERS_READ  // view org membership
  ORG_MEMBERS_WRITE // add/remove/change role of members
}

/// A reachable entity in the Reach network.
/// Humans link to an existing User; AI agents and orgs may be headless.
model ReachActor {
  id           String         @id @default(cuid())
  userId       String?        @unique
  type         ReachActorType
  handle       String         @unique
  displayName  String
  isActive     Boolean        @default(true)
  capabilities Json?          // AI: skill tags, supported intents, etc.
  endpoint     String?        // AI/org: webhook or API callback URL
  apiKeyHash   String?        // hashed API key for headless actors
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  policies            ReachPolicy[]
  initiatedContracts  ReachContract[]    @relation("ContractInitiator")
  receivedContracts   ReachContract[]    @relation("ContractTarget")
  memberships         ReachOrgMember[]   @relation("OrgMember")     // orgs this actor belongs to (as member)
  orgMembers          ReachOrgMember[]   @relation("OrgActor")      // members of this actor (if it's an org)

  @@index([type, isActive])
}

/// Membership linking a human/AI actor to an organization actor.
model ReachOrgMember {
  id        String       @id @default(cuid())
  orgId     String       // the ORGANIZATION actor
  memberId  String       // the HUMAN or AI_AGENT actor
  role      ReachOrgRole @default(MEMBER)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  org    ReachActor @relation("OrgActor", fields: [orgId], references: [id], onDelete: Cascade)
  member ReachActor @relation("OrgMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([orgId, memberId])
  @@index([orgId, isActive, role])
  @@index([memberId, isActive])
}

/// Policy that governs how inbound reach requests are handled for an actor.
model ReachPolicy {
  id                    String           @id @default(cuid())
  actorId               String
  name                  String
  isActive              Boolean          @default(true)
  contractTypes         ReachContractType[] // which contract types this policy covers
  action                ReachPolicyAction @default(ACCEPT)
  maxWeeklyInbound      Int?
  requireVerifiedSender Boolean          @default(false)
  autoAcceptMatching    Boolean          @default(false)
  escalateToHuman       Boolean          @default(false) // AI actors: flag for human override
  filters               Json?            // structured matching criteria (tags, intents, etc.)
  priority              Int              @default(0)      // higher = evaluated first
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  actor     ReachActor      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  contracts ReachContract[]

  @@index([actorId, isActive, priority])
}

/// A reach interaction between two actors, governed by a matched policy.
model ReachContract {
  id             String              @id @default(cuid())
  type           ReachContractType
  status         ReachContractStatus @default(PROPOSED)
  initiatorId    String
  targetId       String
  policyId       String?
  purpose        String              // short description of what the reach is about
  message        String?             // optional freeform message from initiator
  structuredData Json?               // typed payload (varies by contract type)
  responseData   Json?               // target's response payload
  routedAt       DateTime?
  resolvedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  initiator ReachActor           @relation("ContractInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  target    ReachActor           @relation("ContractTarget", fields: [targetId], references: [id], onDelete: Cascade)
  policy    ReachPolicy?         @relation(fields: [policyId], references: [id], onDelete: SetNull)
  events    ReachContractEvent[]

  @@index([initiatorId, status, createdAt])
  @@index([targetId, status, createdAt])
  @@index([status, expiresAt])
}

/// Audit trail for reach contract lifecycle transitions.
model ReachContractEvent {
  id         String                  @id @default(cuid())
  contractId String
  type       ReachContractEventType
  actor      ReachContractEventActor @default(SYSTEM)
  note       String?
  metadata   Json?
  createdAt  DateTime                @default(now())

  contract ReachContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
}
