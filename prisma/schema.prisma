generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContactRevealMethod {
  EMAIL
  URL
  NONE
}

enum CategoryFieldType {
  TEXT
  TEXTAREA
  NUMBER
  URL
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum RequestSource {
  FORM
  EMAIL
}

enum RequestEventType {
  SUBMITTED
  ACCEPTED
  DECLINED
  EXPIRED
  FORWARDED
  AUTO_REPLIED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  INACTIVE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum AdminRole {
  ADMIN
  SUPPORT
}

// Foundation-only table used to validate migrations and connectivity.
// Domain tables are defined in the "Data Model & Schema" roadmap section.
model AppMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())

  @@map("app_meta")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  name          String?
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  accounts      Account[]
  sessions      Session[]
  door          Door?
  payments      Payment[]
  adminProfile  AdminUser?

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Door {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  slug        String   @unique
  displayName String?  @map("display_name")
  headline    String?  @map("headline")
  subhead     String?  @map("subhead")
  trustCopy   String?  @db.Text @map("trust_copy")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings     DoorSettings?
  categories   Category[]
  emailAliases EmailAlias[]
  requests     Request[]

  @@index([userId])
  @@map("doors")
}

model DoorSettings {
  id                  String              @id @default(cuid())
  doorId              String              @unique @map("door_id")
  contactRevealMethod ContactRevealMethod @default(EMAIL) @map("contact_reveal_method")
  contactEmail        String?             @map("contact_email")
  contactUrl          String?             @map("contact_url")
  weeklyRequestCap    Int?                @map("weekly_request_cap")
  dailyRequestCap     Int?                @map("daily_request_cap")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  door Door @relation(fields: [doorId], references: [id], onDelete: Cascade)

  @@map("door_settings")
}

model Category {
  id               String   @id @default(cuid())
  doorId           String   @map("door_id")
  name             String
  slug             String
  description      String?  @db.Text
  isEnabled        Boolean  @default(true) @map("is_enabled")
  position         Int?     @map("position")
  weeklyRequestCap Int?     @map("weekly_request_cap")
  forwardToEmail   String?  @map("forward_to_email")
  autoReplyEnabled Boolean  @default(false) @map("auto_reply_enabled")
  autoReplySubject String?  @map("auto_reply_subject")
  autoReplyBody    String?  @db.Text @map("auto_reply_body")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  door     Door            @relation(fields: [doorId], references: [id], onDelete: Cascade)
  fields   CategoryField[]
  requests Request[]

  @@unique([doorId, slug])
  @@index([doorId])
  @@map("categories")
}

model CategoryField {
  id         String            @id @default(cuid())
  categoryId String            @map("category_id")
  key        String
  label      String
  type       CategoryFieldType
  required   Boolean           @default(false)
  position   Int?              @map("position")
  placeholder String?          @map("placeholder")
  helpText   String?           @map("help_text")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId])
  @@map("category_fields")
}

model EmailAlias {
  id        String   @id @default(cuid())
  doorId    String   @map("door_id")
  alias     String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  door Door @relation(fields: [doorId], references: [id], onDelete: Cascade)

  @@index([doorId])
  @@map("email_aliases")
}

model Request {
  id           String        @id @default(cuid())
  doorId       String        @map("door_id")
  categoryId   String        @map("category_id")
  status       RequestStatus @default(PENDING)
  source       RequestSource @default(FORM)
  subject      String?       @map("subject")
  message      String?       @db.Text @map("message")
  payload      Json?         @map("payload")
  knockerName  String?       @map("knocker_name")
  knockerEmail String?       @map("knocker_email")
  accessToken  String        @unique @map("access_token")
  acceptedAt   DateTime?     @map("accepted_at")
  declinedAt   DateTime?     @map("declined_at")
  expiredAt    DateTime?     @map("expired_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  door     Door         @relation(fields: [doorId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id])
  events   RequestEvent[]

  @@index([doorId])
  @@index([categoryId])
  @@index([status])
  @@map("requests")
}

model RequestEvent {
  id           String           @id @default(cuid())
  requestId    String           @map("request_id")
  type         RequestEventType
  actorUserId  String?          @map("actor_user_id")
  actorAdminId String?          @map("actor_admin_id")
  metadata     Json?            @map("metadata")
  createdAt    DateTime         @default(now()) @map("created_at")

  request    Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUser  User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAdmin AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([actorUserId])
  @@index([actorAdminId])
  @@map("request_events")
}

model Payment {
  id                     String          @id @default(cuid())
  userId                 String          @map("user_id")
  provider               PaymentProvider @default(STRIPE)
  providerCustomerId     String?         @map("provider_customer_id")
  providerSubscriptionId String?         @map("provider_subscription_id")
  status                 PaymentStatus   @default(INACTIVE)
  priceId                String?         @map("price_id")
  productId              String?         @map("product_id")
  currentPeriodEnd       DateTime?       @map("current_period_end")
  cancelAtPeriodEnd      Boolean         @default(false) @map("cancel_at_period_end")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([provider, providerSubscriptionId])
  @@map("payments")
}

model AdminUser {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestEvents RequestEvent[]

  @@map("admin_users")
}
